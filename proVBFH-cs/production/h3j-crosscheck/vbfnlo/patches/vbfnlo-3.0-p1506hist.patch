+c     p1506hist.F: histogram storage (p1506_analysis.f observables)
+      integer p15nhmax, p15nbmax, p15nrand
+      parameter (p15nhmax=30, p15nbmax=100, p15nrand=30)
+      integer nh, nb(p15nhmax)
+      real*8 edges(0:p15nbmax,p15nhmax)
+      real*8 buf(p15nbmax,p15nhmax)
+      real*8 s1(p15nbmax,p15nhmax), s2(p15nbmax,p15nhmax)
+      real*8 res(p15nbmax,p15nhmax,2), var(p15nbmax,p15nhmax,2)
+      real*8 lastrand(p15nrand), lastweight
+      logical booked, pending, havepass(2)
+      character*40 hname(p15nhmax)
+      common /p1506c/ edges, buf, s1, s2, res, var, lastrand,
+     &     lastweight, nh, nb, booked, pending, havepass
+      common /p1506n/ hname
+      save /p1506c/, /p1506n/
