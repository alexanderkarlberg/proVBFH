+
+      subroutine pw_kp(xi,p,S,f0)
+      implicit none
+#include "VBFNLO/utilities/global.inc"
+#include "VBFNLO/utilities/scales.inc"
+#include "color.inc"
+      real*8 xi(2),p(0:3,max_p,max_kin),S(-5:5,4),f0(-5:5,2)
+      real*8 Aq(2),Bq(3),Cq(3),Dq(3),rn,x1,Jac,fx(-6:6),f1(-6:6),qsf,asotpi
+      real*8 xn(96),wn(96),t,p1,p2,p3,pp,t1
+      integer ipp(4),app(4),typ(4),i,jx,n,jj,it,bm
+      integer nn
+      real*8 sumq
+      parameter (nn=96)
+      data ipp/3,5,4,5/, app/1,1,2,2/, typ/1,2,1,2/
+      do i=1,(nn+1)/2
+         t=cos(3.141592653589793d0*(i-0.25d0)/(nn+0.5d0))
+         do it=1,100
+            p1=1d0
+            p2=0d0
+            do jj=1,nn
+               p3=p2
+               p2=p1
+               p1=((2*jj-1)*t*p2-(jj-1)*p3)/jj
+            enddo
+            pp=nn*(t*p1-p2)/(t*t-1d0)
+            t1=t
+            t=t1-p1/pp
+            if (abs(t-t1).lt.1d-15) goto 10
+         enddo
+ 10      xn(i)=(1d0-t)/2d0
+         xn(nn+1-i)=(1d0+t)/2d0
+         wn(i)=1d0/((1d0-t*t)*pp*pp)
+         wn(nn+1-i)=wn(i)
+      enddo
+      asotpi=als(1,1)/(2d0*3.141592653589793d0)
+      do bm=1,2
+         qsf=sqrt(mufsq(bm,1))
+         call pdfproton(xi(bm),qsf,fx)
+         do i=-5,5
+            f0(i,bm)=fx(i)
+         enddo
+      enddo
+      do jx=1,4
+         bm=app(jx)
+         qsf=sqrt(mufsq(bm,1))
+         call pdfproton(xi(bm),qsf,fx)
+         do i=-5,5
+            S(i,jx)=0d0
+         enddo
+         do n=1,nn
+            rn=xn(n)
+            x1=(1d0-xi(bm))*rn**2+xi(bm)
+            x1=xi(bm)/x1
+            Jac=(1d0-xi(bm))*2d0*rn
+            call pdfproton(x1,qsf,f1)
+            call fincollinear(Aq,Bq,Cq,Dq,xi,rn,p,ipp(jx),app(jx))
+            sumq=0d0
+            do i=1,5
+               sumq=sumq+f1(i)+f1(-i)
+            enddo
+            S(0,jx)=S(0,jx)+wn(n)*asotpi*Jac*
+     $           ((f1(0)-fx(0))*Bq(3)+f1(0)*Cq(3)+sumq*Aq(1))
+            do i=-5,5
+               if (i.ne.0) S(i,jx)=S(i,jx)+wn(n)*asotpi*Jac*
+     $           ((f1(i)-fx(i))*Bq(typ(jx))+f1(i)*Cq(typ(jx))+f1(0)*Aq(2))
+            enddo
+         enddo
+         call fincollinear(Aq,Bq,Cq,Dq,xi,0.5d0,p,ipp(jx),app(jx))
+         do i=-5,5
+            if (i.ne.0) S(i,jx)=S(i,jx)+asotpi*fx(i)*Dq(typ(jx))
+         enddo
+         S(0,jx)=S(0,jx)+asotpi*fx(0)*Dq(3)
+      enddo
+      end
