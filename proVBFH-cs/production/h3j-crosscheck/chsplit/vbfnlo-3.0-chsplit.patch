 c*****************************************************************************
+
+c*****************************************************************************
+c     Diagnostic channel split (proVBFH notes/2026-10-cs-production, 8 Oct 2026)
+c     Environment: CHAN_BOSON = NC | CC | ALL; CHAN_INIT = ALL or two letters
+c     (beam 1, beam 2) out of q (quark or antiquark), g (gluon), a (any).
+c     chs_pdf: parton-type flags on every PDF evaluation of process 110
+c     (Born, virtual, I, K/P at x/z, reals, dipoles);
+c     chs_nc/chs_cc: NC (ZZ) and CC (WW) matrix elements on output of every
+c     matrix-element routine (Born, virtual, real, dipole Borns).
+c*****************************************************************************
+      subroutine chs_init
+      implicit none
+      double precision chq(2), chg(2), chnc, chcc
+      common /chsplit/ chq, chg, chnc, chcc
+      logical first
+      data first /.true./
+      save first
+      character*64 s
+      integer b
+      if (.not.first) return
+      first = .false.
+      chq(1) = 1d0
+      chq(2) = 1d0
+      chg(1) = 1d0
+      chg(2) = 1d0
+      chnc = 1d0
+      chcc = 1d0
+      call get_environment_variable('CHAN_BOSON', s)
+      if (s.eq.'NC' .or. s.eq.'nc') then
+         chcc = 0d0
+      elseif (s.eq.'CC' .or. s.eq.'cc') then
+         chnc = 0d0
+      elseif (s.ne.' ' .and. s.ne.'ALL' .and. s.ne.'all') then
+         stop 'chsplit: CHAN_BOSON must be NC, CC or ALL'
+      endif
+      call get_environment_variable('CHAN_INIT', s)
+      if (s.ne.' ' .and. s.ne.'ALL' .and. s.ne.'all') then
+         if (len_trim(s).ne.2) stop 'chsplit: CHAN_INIT'
+         do b = 1, 2
+            if (s(b:b).eq.'q' .or. s(b:b).eq.'Q') then
+               chg(b) = 0d0
+            elseif (s(b:b).eq.'g' .or. s(b:b).eq.'G') then
+               chq(b) = 0d0
+            elseif (s(b:b).ne.'a' .and. s(b:b).ne.'A') then
+               stop 'chsplit: CHAN_INIT'
+            endif
+         enddo
+      endif
+      write(6,'(a,2f4.1,a,2f4.1,a,2f4.1)') ' chsplit: NC CC',
+     &   chnc, chcc, '  q flags', chq, '  g flags', chg
+      end
+
+      subroutine chs_pdf(b, f)
+      implicit none
+      integer b, i
+      double precision f(-6:6)
+      double precision chq(2), chg(2), chnc, chcc
+      common /chsplit/ chq, chg, chnc, chcc
+      call chs_init
+      if (chq(b).eq.1d0 .and. chg(b).eq.1d0) return
+      f(0) = f(0)*chg(b)
+      do i = 1, 6
+         f(i) = f(i)*chq(b)
+         f(-i) = f(-i)*chq(b)
+      enddo
+      end
+
+      subroutine chs_nc(a, n)
+      implicit none
+      integer n, i
+      double precision a(n)
+      double precision chq(2), chg(2), chnc, chcc
+      common /chsplit/ chq, chg, chnc, chcc
+      call chs_init
+      if (chnc.eq.1d0) return
+      do i = 1, n
+         a(i) = a(i)*chnc
+      enddo
+      end
+
+      subroutine chs_cc(a, n)
+      implicit none
+      integer n, i
+      double precision a(n)
+      double precision chq(2), chg(2), chnc, chcc
+      common /chsplit/ chq, chg, chnc, chcc
+      call chs_init
+      if (chcc.eq.1d0) return
+      do i = 1, n
+         a(i) = a(i)*chcc
+      enddo
+      end
