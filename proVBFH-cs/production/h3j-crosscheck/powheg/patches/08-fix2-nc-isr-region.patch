+c h3j fix 2 (bug report, problem 2): partition of unity for the NC
+c four-quark reals between the entry with the pair tag on the outgoing
+c pair (final-state region: the pair's q || qbar) and the entries with
+c the pair tag on incoming quark 1 or 2 (initial-state region: the
+c outgoing quark of the gluon-emitting line || its beam).
+c Distances as POWHEG's (getdistance, par_diexp = par_dijexp = 1) in the
+c partonic c.m. frame, written with invariants (P = p1 + p2, s = P^2):
+c   d_F  = 2 pU.pUb E_U E_Ub/(E_U+E_Ub)^2,   E_k = P.k/sqrt(s)
+c   d_I1 = 2 E_S^2 (1 - cos theta(S,p1)) = 4 (P.kS)(p1.kS)/s
+c   d_I2 = 4 (P.kC)(p2.kC)/s
+c with S (C) the outgoing quark of the line from beam 1 (2) and U, Ub
+c the q qbar pair attached to it by the gluon. The legs are assigned by
+c role, so all three entries of a flavour structure use the same
+c weights at the same physical point:
+c   col_del = 2 (pair outgoing): S = 4, C = 5, pair = 6, 7
+c   col_del = 3 (pair tag on incoming 1): S = 7, C = 5, pair = 4, 6
+c   col_del = 1 (pair tag on incoming 2): S = 4, C = 7, pair = 5, 6
+c Returned: wup_f = d_I1/(d_I1+d_F), wup_i = d_F/(d_I1+d_F) (and the
+c same for the lower line with d_I2), wup_f + wup_i = 1.
+      subroutine h3j_nc4q_part(pin,col_del,wup_f,wup_i,wlo_f,wlo_i)
+      implicit none
+      real*8 pin(0:3,7),wup_f,wup_i,wlo_f,wlo_i
+      integer col_del
+      integer iS,iC,iU,iUb,mu
+      real*8 pp(0:3),s,df,di1,di2,eu,eub,h3j_dot
+      external h3j_dot
+      if (col_del.eq.2) then
+         iS = 4
+         iC = 5
+         iU = 6
+         iUb = 7
+      elseif (col_del.eq.3) then
+         iS = 7
+         iC = 5
+         iU = 4
+         iUb = 6
+      elseif (col_del.eq.1) then
+         iS = 4
+         iC = 7
+         iU = 5
+         iUb = 6
+      else
+         stop 'h3j_nc4q_part: unexpected col_del'
+      endif
+      do mu=0,3
+         pp(mu) = pin(mu,1)+pin(mu,2)
+      enddo
+      s = h3j_dot(pp,pp)
+      eu = h3j_dot(pp,pin(0,iU))
+      eub = h3j_dot(pp,pin(0,iUb))
+      df = 2*h3j_dot(pin(0,iU),pin(0,iUb))*eu*eub/(eu+eub)**2
+      di1 = 4*h3j_dot(pp,pin(0,iS))*h3j_dot(pin(0,1),pin(0,iS))/s
+      di2 = 4*h3j_dot(pp,pin(0,iC))*h3j_dot(pin(0,2),pin(0,iC))/s
+      df = abs(df)
+      di1 = abs(di1)
+      di2 = abs(di2)
+      if (di1+df.gt.0d0) then
+         wup_f = di1/(di1+df)
+         wup_i = df/(di1+df)
+      else
+         wup_f = 0.5d0
+         wup_i = 0.5d0
+      endif
+      if (di2+df.gt.0d0) then
+         wlo_f = di2/(di2+df)
+         wlo_i = df/(di2+df)
+      else
+         wlo_f = 0.5d0
+         wlo_i = 0.5d0
+      endif
+      end
+
+      real*8 function h3j_dot(a,b)
+      implicit none
+      real*8 a(0:3),b(0:3)
+      h3j_dot = a(0)*b(0)-a(1)*b(1)-a(2)*b(2)-a(3)*b(3)
+      end
