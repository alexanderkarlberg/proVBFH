+c-----------------------------------------------------------------------
+c  pointwise-comparison instrumentation (not part of VBFNLO)
+c-----------------------------------------------------------------------
+      block data pwbd
+      implicit none
+      integer pw_mode,pw_perm(4),pw_ntouch,pw_nzero
+      integer pw_flv(6,8000),pw_nd,pw_nev,pw_ncall
+      double precision pw_acc(0:1771560)
+      integer pw_touch(1771561)
+      common /pwc/ pw_acc,pw_touch,pw_flv,pw_mode,pw_perm,pw_ntouch,pw_nzero,pw_nd,pw_nev,pw_ncall
+      data pw_mode/0/,pw_ntouch/0/,pw_nzero/0/,pw_nd/0/,pw_nev/0/,pw_ncall/0/
+      data pw_perm/1,2,3,4/
+      end
+
+      subroutine pw_rec(ifl,k,val,pp)
+      implicit none
+      integer ifl(6),k
+      double precision val,pp
+      integer pw_mode,pw_perm(4),pw_ntouch,pw_nzero
+      integer pw_flv(6,8000),pw_nd,pw_nev,pw_ncall
+      double precision pw_acc(0:1771560)
+      integer pw_touch(1771561)
+      common /pwc/ pw_acc,pw_touch,pw_flv,pw_mode,pw_perm,pw_ntouch,pw_nzero,pw_nd,pw_nev,pw_ncall
+      double precision pw_pp(0:1771560)
+      common /pwpp/ pw_pp
+      integer fm(4),i,idx
+      do i=1,6
+         pw_flv(i,k)=ifl(i)
+      enddo
+      if (pw_mode.eq.0) return
+      if (val.eq.0d0) return
+      if (pp.eq.0d0) then
+         pw_nzero=pw_nzero+1
+         return
+      endif
+      do i=1,4
+         fm(pw_perm(i))=ifl(2+i)
+      enddo
+      idx=(((((ifl(1)+5)*11+(ifl(2)+5))*11+(fm(1)+5))*11+(fm(2)+5))*11+(fm(3)+5))*11+(fm(4)+5)
+      if (pw_acc(idx).eq.0d0) then
+         pw_ntouch=pw_ntouch+1
+         pw_touch(pw_ntouch)=idx
+      endif
+      pw_pp(idx)=pp
+      pw_acc(idx)=pw_acc(idx)+val/pp
+      end
+
+      subroutine pw_dumpD(res,nmax,lok,p,v)
+      implicit none
+#include "VBFNLO/utilities/global.inc"
+#include "VBFNLO/utilities/lha.inc"
+      double precision res(maxnumsubproc,0:max_kin)
+      double precision p(0:3,max_p,max_kin), v(0:3,max_v,max_kin)
+      integer nmax
+      logical lok(max_kin)
+      integer pw_mode,pw_perm(4),pw_ntouch,pw_nzero
+      integer pw_flv(6,8000),pw_nd,pw_nev,pw_ncall
+      double precision pw_acc(0:1771560)
+      integer pw_touch(1771561)
+      common /pwc/ pw_acc,pw_touch,pw_flv,pw_mode,pw_perm,pw_ntouch,pw_nzero,pw_nd,pw_nev,pw_ncall
+      integer k,nd,i
+      logical any
+      double precision pw_r4q,pw_rgl
+      common /pwr/ pw_r4q,pw_rgl
+      pw_r4q=0d0
+      pw_rgl=0d0
+      do k=1,nmax
+         if (res(k,1).ne.0d0) then
+            if (pw_flv(1,k).ne.0.and.pw_flv(2,k).ne.0.and.pw_flv(3,k).ne.0.and.pw_flv(4,k).ne.0.and.pw_flv(5,k).ne.0.and.pw_flv(6,k).ne.0) then
+               pw_r4q=pw_r4q+res(k,1)
+            else
+               pw_rgl=pw_rgl+res(k,1)
+            endif
+         endif
+      enddo
+      if (pw_mode.eq.3) then
+         do k=1,nmax
+            if (res(k,1).ne.0d0) then
+               pw_rgl=0d0
+               do nd=2,n_kin
+                  pw_rgl=pw_rgl+res(k,nd)
+               enddo
+               write(98,'(a,6i3,2es16.8,es12.4)') 'LK ',(pw_flv(i,k),i=1,6),res(k,1),pw_rgl,(res(k,1)+pw_rgl)/res(k,1)
+               if (pw_flv(1,k).eq.2.and.pw_flv(2,k).eq.1.and.pw_flv(3,k).eq.1.and.pw_flv(4,k).eq.2.and.pw_flv(5,k).eq.0) then
+                  write(98,'(a,25es10.2)') 'LD ',(res(k,nd)/res(k,1),nd=2,n_kin)
+               endif
+            endif
+         enddo
+         return
+      endif
+      if (pw_mode.ne.2) return
+      do k=1,nmax
+         any=.false.
+         do nd=2,n_kin
+            if (res(k,nd).ne.0d0) any=.true.
+         enddo
+         if (any) then
+            write(97,'(a,7i3,es24.16,25es24.16)') 'D ',k,(pw_flv(i,k),i=1,6),res(k,1),(res(k,nd),nd=2,n_kin)
+         endif
+      enddo
+      end
+
+      subroutine m2s_wbfh4j(bos,nlo,lok,xi,p,v,xuz,m2s)
+      implicit none
+#include "VBFNLO/utilities/global.inc"
+#include "VBFNLO/utilities/scales.inc"
+      integer bos,nlo
+      double precision xi(nx), p(0:3,max_p,max_kin), v(0:3,max_v,max_kin),
+     1     xuz(2,2:max_kin), m2s(0:max_kin)
+      logical lok(max_kin)
+      integer pw_mode,pw_perm(4),pw_ntouch,pw_nzero
+      integer pw_flv(6,8000),pw_nd,pw_nev,pw_ncall
+      double precision pw_acc(0:1771560)
+      integer pw_touch(1771561)
+      common /pwc/ pw_acc,pw_touch,pw_flv,pw_mode,pw_perm,pw_ntouch,pw_nzero,pw_nd,pw_nev,pw_ncall
+      double precision pw_pp(0:1771560)
+      common /pwpp/ pw_pp
+      double precision pp(0:3,max_p,max_kin), m2sd(0:max_kin)
+      logical lokd(max_kin), anyok
+      integer nd,i,j,mu,a,b,c,d,idx,ip,ndump_max,nperm_max,stride
+      integer perms(4,24)
+      integer fm(6),r
+      logical first
+      integer nperm,pwvar,ilen,pwlim,nlimdone
+      character*20 envv
+      double precision pw_r4q,pw_rgl
+      common /pwr/ pw_r4q,pw_rgl
+      data first/.true./,nperm/0/,pwvar/-1/,pwlim/-1/,nlimdone/0/
+      save first,perms,nperm,pwvar,pwlim,nlimdone
+      ndump_max=800
+      nperm_max=250
+      stride=3
+      if (first) then
+         first=.false.
+         ip=0
+         do a=1,4
+          do b=1,4
+           do c=1,4
+            do d=1,4
+             if (a.ne.b.and.a.ne.c.and.a.ne.d.and.b.ne.c.and.b.ne.d.and.c.ne.d) then
+                ip=ip+1
+                perms(1,ip)=a
+                perms(2,ip)=b
+                perms(3,ip)=c
+                perms(4,ip)=d
+             endif
+            enddo
+           enddo
+          enddo
+         enddo
+      endif
+      if (pwvar.lt.0) then
+         pwvar=0
+         call get_environment_variable('PW_VAR',envv,ilen)
+         if (ilen.gt.0) read(envv,*) pwvar
+      endif
+      pw_ncall=pw_ncall+1
+      anyok=.false.
+      do nd=1,n_kin
+         if (lok(nd)) anyok=.true.
+      enddo
+      if (pwvar.gt.0) ndump_max=0
+      if (pwlim.lt.0) then
+         pwlim=0
+         call get_environment_variable('PW_LIM',envv,ilen)
+         if (ilen.gt.0) read(envv,*) pwlim
+      endif
+      if (nlo.eq.1 .and. anyok .and. mod(pw_ncall,stride).eq.0 .and. pw_nev.lt.ndump_max) then
+         pw_nev=pw_nev+1
+         if (pw_nev.eq.1) open(97,file='pw4_vbfnlo.dat',status='replace')
+         write(97,'(a,i6,i4,4es24.16,25l2)') 'EV ',pw_nev,n_kin,xi(1),xi(2),als(1,1),mursq(1,1),(lok(nd),nd=1,n_kin)
+         do nd=1,n_kin
+            write(97,'(a,i3,l2,6(4es24.16))') 'P ',nd,lok(nd),((p(mu,i,nd),mu=0,3),i=1,6)
+         enddo
+         pw_mode=2
+         pw_ntouch=0
+         pw_nzero=0
+         do i=1,4
+            pw_perm(i)=i
+         enddo
+         call m2s_wbfh4j_in(bos,nlo,lok,xi,p,v,xuz,m2s)
+         if (lok(1) .and. nperm.lt.nperm_max) then
+            nperm=nperm+1
+            pw_mode=1
+            do ip=2,24
+               do i=1,4
+                  pw_perm(i)=perms(i,ip)
+               enddo
+               pp=p
+               do i=1,4
+                  do mu=0,3
+                     pp(mu,2+i,1)=p(mu,2+pw_perm(i),1)
+                  enddo
+               enddo
+               lokd=.false.
+               lokd(1)=.true.
+               call m2s_wbfh4j_in(bos,nlo,lokd,xi,pp,v,xuz,m2sd)
+            enddo
+         endif
+         pw_mode=0
+         if (pwlim.gt.0 .and. lok(1) .and. nlimdone.lt.pwlim) then
+            nlimdone=nlimdone+1
+            write(99,'(a,i6)') 'LIMEVENT ',pw_nev
+            call pw_limits(bos,nlo,xi,p,v)
+         endif
+         do j=1,pw_ntouch
+            idx=pw_touch(j)
+            r=idx
+            do i=6,1,-1
+               fm(i)=mod(r,11)-5
+               r=r/11
+            enddo
+            write(97,'(a,6i3,2es24.16)') 'A ',(fm(i),i=1,6),pw_acc(idx),pw_pp(idx)
+            pw_acc(idx)=0d0
+         enddo
+         write(97,'(a,2i8)') 'END ',pw_ntouch,pw_nzero
+         call flush(97)
+         pw_ntouch=0
+      else
+         call m2s_wbfh4j_in(bos,nlo,lok,xi,p,v,xuz,m2s)
+         if (pwvar.eq.1) m2s(0)=m2s(1)
+         if (pwvar.eq.2) m2s(0)=pw_r4q
+         if (pwvar.eq.3) m2s(0)=pw_rgl
+      endif
+      end
+
