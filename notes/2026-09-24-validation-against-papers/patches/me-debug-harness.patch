+      subroutine debug_compare(ptH1H2, wgt)
+      use matrix_element_dihiggs
+      use parameters
+      implicit none
+      include 'pwhg_kn.h'
+      double precision ptH1H2, wgt, dN, dT0, dTnoF3, dNnoF3
+      double precision sN, sT0, sTnoF3, sNnoF3, sN2, sT2, sD2
+      integer*8 npts
+      data npts/0/, sN/0d0/, sT0/0d0/, sTnoF3/0d0/, sNnoF3/0d0/
+      data sN2/0d0/, sT2/0d0/, sD2/0d0/
+      save
+      npts = npts + 1
+      dN = wgt*jacobian*eval_matrix_element(order_min,order_max,
+     $     x1, x2, kn_beams(:,1), kn_beams(:,2), vq1, vq2, pH1, pH2,
+     $     ptH1H2)
+      dT0 = wgt*jacobian*eval_matrix_element_tensor(order_min,
+     $     order_max, x1, x2, kn_beams(:,1), kn_beams(:,2), vq1, vq2,
+     $     pH1, pH2, ptH1H2)
+      tensor_F_mode = 1
+      dTnoF3 = wgt*jacobian*eval_matrix_element_tensor(order_min,
+     $     order_max, x1, x2, kn_beams(:,1), kn_beams(:,2), vq1, vq2,
+     $     pH1, pH2, ptH1H2)
+      tensor_F_mode = 0
+      keep1 = -1; keep2 = -1
+      dNnoF3 = wgt*jacobian*eval_matrix_element(order_min,order_max,
+     $     x1, x2, kn_beams(:,1), kn_beams(:,2), vq1, vq2, pH1, pH2,
+     $     ptH1H2)
+      keep1 = 0; keep2 = 0
+      sN = sN + dN; sT0 = sT0 + dT0; sTnoF3 = sTnoF3 + dTnoF3
+      sNnoF3 = sNnoF3 + dNnoF3
+      sN2 = sN2 + dN**2; sT2 = sT2 + dT0**2; sD2 = sD2 + (dN-dT0)**2
+      if (mod(npts,500000_8).eq.0) then
+         open(unit=77, file='me_integrals.dat')
