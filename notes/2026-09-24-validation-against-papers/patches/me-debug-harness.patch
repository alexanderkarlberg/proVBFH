   !----------------------------------------------------------------------
   ! dot product
+  subroutine keep_only(F, k)
+    real(dp), intent(inout) :: F(-6:7)
+    integer, intent(in) :: k
+    if (k == 0) return
+    if (k == -1) then ! drop F3 only
+       F(iF3Wp) = zero; F(iF3Wm) = zero; F(iF3Z) = zero
+       return
+    end if
+    if (k /= 1) then; F(iF1Wp) = zero; F(iF1Wm) = zero; F(iF1Z) = zero; end if
+    if (k /= 2) then; F(iF2Wp) = zero; F(iF2Wm) = zero; F(iF2Z) = zero; end if
+    if (k /= 3) then; F(iF3Wp) = zero; F(iF3Wm) = zero; F(iF3Z) = zero; end if
+  end subroutine keep_only
+
   real(dp) function dot(p1,p2)
     real(dp), intent(in) :: p1(0:3), p2(0:3)
     dot = p1(0)*p2(0) - sum(p1(1:3)*p2(1:3))
